  fhir:text [
     fhir:status [ fhir:v "extensions" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ValueSet observation-symptom-codes</b></p><a name=\"observation-symptom-codes\"> </a><a name=\"hcobservation-symptom-codes\"> </a><ul><li>Include these codes as defined in <a href=\"CodeSystem-observation-pghd-codes.html\"><code>http://hl7.org/fhir/uv/phr/CodeSystem/observation-pghd-codes</code></a><span title=\"Version is not explicitly stated, which means it is fixed to the version provided in this specification\"> version ?1.0.0-ballot2</span><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td><td><b><a href=\"ValueSet-observation-symptom-snomedct-codes.html\">ConceptMap[http://hl7.org/fhir/uv/phr/ConceptMap/symptom-pghd-to-snomedct|1.0.0-ballot2]</a></b></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-abdominalCramps\">abdominalCramps</a></td><td style=\"color: #cccccc\">Bdominal cramps</td><td>A category type that records abdominal cramps as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/51197009\">51197009</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-acne\">acne</a></td><td style=\"color: #cccccc\">Acne</td><td>A category type that records acne as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/403364000\">403364000</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-appetiteChanges\">appetiteChanges</a></td><td style=\"color: #cccccc\">Appetite changes</td><td>A category type that records changes in appetite as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/249473004\">249473004</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-bladderIncontinence\">bladderIncontinence</a></td><td style=\"color: #cccccc\">Bladder incontinence</td><td>A category type that records bladder incontinence as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/165232002\">165232002</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-bloating\">bloating</a></td><td style=\"color: #cccccc\">Bloating</td><td>A category type that records bloating as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/116289008\">116289008</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-breastPain\">breastPain</a></td><td style=\"color: #cccccc\">Breast pain</td><td>A category type that records breast pain as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/53430007\">53430007</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-chestTightnessOrPain\">chestTightnessOrPain</a></td><td style=\"color: #cccccc\">Chest tightness or pain</td><td>A category type that records chest tightness or pain as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/23924001\">23924001</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-chills\">chills</a></td><td style=\"color: #cccccc\">Chills</td><td>A category type that records chills as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/43724002\">43724002</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-constipation\">constipation</a></td><td style=\"color: #cccccc\">Constipation</td><td>A category type that records constipation as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/14760008\">14760008</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-coughing\">coughing</a></td><td style=\"color: #cccccc\">Coughing</td><td>A category type that records coughing as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/49727002\">49727002</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-diarrhea\">diarrhea</a></td><td style=\"color: #cccccc\">Diarrhea</td><td>A category type that records diarrhea as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/62315008\">62315008</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-dizziness\">dizziness</a></td><td style=\"color: #cccccc\">Dizziness</td><td>A category type that records dizziness as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/404640003\">404640003</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-drySkin\">drySkin</a></td><td style=\"color: #cccccc\">Dry skin</td><td>A category type that records dry skin as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/106076001\">106076001</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-fainting\">fainting</a></td><td style=\"color: #cccccc\">Fainting</td><td>A category type that records fainting as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/271594007\">271594007</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-fatigue\">fatigue</a></td><td style=\"color: #cccccc\">Fatigue</td><td>A category type that records fatigue as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/84229001\">84229001</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-fever\">fever</a></td><td style=\"color: #cccccc\">Fever</td><td>A category type that records fever as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/386661006\">386661006</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-generalizedBodyAche\">generalizedBodyAche</a></td><td style=\"color: #cccccc\">Generalized body ache</td><td>A category type that records body ache as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/22253000\">22253000</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-hairLoss\">hairLoss</a></td><td style=\"color: #cccccc\">Hair loss</td><td>A category type that records hair loss as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/278040002\">278040002</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-headache\">headache</a></td><td style=\"color: #cccccc\">Headache</td><td>A category type that records headache as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/25064002\">25064002</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-heartburn\">heartburn</a></td><td style=\"color: #cccccc\">Heartburn</td><td>A category type that records heartburn as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/16331000\">16331000</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-hotFlashes\">hotFlashes</a></td><td style=\"color: #cccccc\">Hot flashes</td><td>A category type that records hot flashes as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/198436008\">198436008</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-lossOfSmell\">lossOfSmell</a></td><td style=\"color: #cccccc\">Loss of smell</td><td>A category type that records loss of smell as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/44169009\">44169009</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-lossOfTaste\">lossOfTaste</a></td><td style=\"color: #cccccc\">Loss of taste</td><td>A category type that records loss of taste as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/36955009\">36955009</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-lowerBackPain\">lowerBackPain</a></td><td style=\"color: #cccccc\">Lower back pain</td><td>A category type that records lower back pain as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/279039007\">279039007</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-memoryLapse\">memoryLapse</a></td><td style=\"color: #cccccc\">Memory lapse</td><td>A category type that records memory lapse as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/225038006\">225038006</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-moodChanges\">moodChanges</a></td><td style=\"color: #cccccc\">Mood changes</td><td>A category type that records mood changes as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/106131003\">106131003</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-nausea\">nausea</a></td><td style=\"color: #cccccc\">Nausea</td><td>A category type that records nausea as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/422587007\">422587007</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-nightSweats\">nightSweats</a></td><td style=\"color: #cccccc\">Night sweats</td><td>A category type that records night sweats as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/42984000\">42984000</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-pelvicPain\">pelvicPain</a></td><td style=\"color: #cccccc\">Pelvic pain</td><td>A category type that records pelvic pain as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/30473006\">30473006</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-rapidPoundingOrFlutteringHeartbeat\">rapidPoundingOrFlutteringHeartbeat</a></td><td style=\"color: #cccccc\">Rapid pounding or fluttering heartbeat</td><td>A category type that records a rapid,  pounding,  or fluttering heartbeat as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/80313002\">80313002</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-runnyNose\">runnyNose</a></td><td style=\"color: #cccccc\">Runny nose</td><td>A category type that records runny nose as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/64531003\">64531003</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-shortnessOfBreath\">shortnessOfBreath</a></td><td style=\"color: #cccccc\">Shortness of breath</td><td>A category type that records shortness of breath as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/267036007\">267036007</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-sinusCongestion\">sinusCongestion</a></td><td style=\"color: #cccccc\">Sinus congestion</td><td>A category type that records sinus congestion as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/68235000\">68235000</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-skippedHeartbeat\">skippedHeartbeat</a></td><td style=\"color: #cccccc\">Skipped heartbeat</td><td>A category type that records skipped heartbeat as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/80313002\">80313002</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-sleepChanges\">sleepChanges</a></td><td style=\"color: #cccccc\">Sleep changes</td><td>A category type that records sleep changes as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/247950007\">247950007</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-soreThroat\">soreThroat</a></td><td style=\"color: #cccccc\">Sore throat</td><td>A category type that records sore throat as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/267102003\">267102003</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-vaginalDryness\">vaginalDryness</a></td><td style=\"color: #cccccc\">Vaginal dryness</td><td>A category type that records vaginal dryness as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/31908003\">31908003</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-vomiting\">vomiting</a></td><td style=\"color: #cccccc\">Vomiting</td><td>A category type that records vomiting as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/300359004\">300359004</a></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-wheezing\">wheezing</a></td><td style=\"color: #cccccc\">Wheezing</td><td>A category type that records wheezing as a symptom.</td><td><span title=\"EQUIVALENT\">~</span><a href=\"http://snomed.info/id/56018004\">56018004</a></td></tr></table></li></ul></div>"^^rdf:XMLLiteral ]
