  ] [
     fhir:name [ fhir:v "_since" ] ;
     fhir:use [ fhir:v "in" ] ;
     fhir:min [ fhir:v 0 ] ;
     fhir:max [ fhir:v "1" ] ;
     fhir:documentation [ fhir:v "Only include resources updated after this instant. Same meaning as in Patient/$everything." ] ;
     fhir:type [ fhir:v "instant" ]
  ] [
     fhir:name [ fhir:v "_type" ] ;
     fhir:use [ fhir:v "in" ] ;
     fhir:min [ fhir:v 0 ] ;
     fhir:max [ fhir:v "1" ] ;
     fhir:documentation [ fhir:v "Comma-separated list of resource types to include. Same meaning as in Patient/$everything." ] ;
     fhir:type [ fhir:v "string" ]
  ] [
     fhir:name [ fhir:v "return" ] ;
     fhir:use [ fhir:v "out" ] ;
     fhir:min [ fhir:v 1 ] ;
     fhir:max [ fhir:v "1" ] ;
     fhir:documentation [ fhir:v "The exported record: a Bundle when outputFormat is bundle, otherwise a Binary wrapping the NDJSON (.phr) or zip (.sphr) content." ] ;
     fhir:type [ fhir:v "Resource" ]
  ] ) . # 

