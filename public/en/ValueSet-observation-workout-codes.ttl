# - resource -------------------------------------------------------------------

<http://hl7.org/fhir/uv/phr/ValueSet/observation-workout-codes> a fhir:ValueSet ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "observation-workout-codes"] ; # 
  fhir:language [ fhir:v "en"] ; # 
  fhir:text [
     fhir:status [ fhir:v "extensions" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ValueSet observation-workout-codes</b></p><a name=\"observation-workout-codes\"> </a><a name=\"hcobservation-workout-codes\"> </a><ul><li>Include these codes as defined in <a href=\"CodeSystem-observation-pghd-codes.html\"><code>http://hl7.org/fhir/uv/phr/CodeSystem/observation-pghd-codes</code></a><span title=\"Version is not explicitly stated, which means it is fixed to the version provided in this specification\"> version ?1.0.0-ballot2</span><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-americanFootball\">americanFootball</a></td><td style=\"color: #cccccc\">American football</td><td>The constant for playing American football.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-archery\">archery</a></td><td style=\"color: #cccccc\">Archery</td><td>The constant for shooting archery.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-australianFootball\">australianFootball</a></td><td style=\"color: #cccccc\">Australian football</td><td>The constant for playing Australian football.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-badminton\">badminton</a></td><td style=\"color: #cccccc\">Badminton</td><td>The constant for playing badminton.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-barre\">barre</a></td><td style=\"color: #cccccc\">Barre</td><td>The constant for barre workout.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-baseball\">baseball</a></td><td style=\"color: #cccccc\">Baseball</td><td>The constant for playing baseball.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-basketball\">basketball</a></td><td style=\"color: #cccccc\">Basketball</td><td>The constant for playing basketball.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-bowling\">bowling</a></td><td style=\"color: #cccccc\">Bowling</td><td>The constant for bowling.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-boxing\">boxing</a></td><td style=\"color: #cccccc\">Boxing</td><td>The constant for boxing.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-cardioDance\">cardioDance</a></td><td style=\"color: #cccccc\">Cardio dance</td><td>The constant for cardiovascular dance workouts.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-climbing\">climbing</a></td><td style=\"color: #cccccc\">Climbing</td><td>The constant for climbing.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-cooldown\">cooldown</a></td><td style=\"color: #cccccc\">Cooldown</td><td>The constant for low intensity stretching and mobility exercises following a more vigorous workout.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-coreTraining\">coreTraining</a></td><td style=\"color: #cccccc\">Core training</td><td>The constant for core training.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-cricket\">cricket</a></td><td style=\"color: #cccccc\">Cricket</td><td>The constant for playing cricket.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-crossCountrySkiing\">crossCountrySkiing</a></td><td style=\"color: #cccccc\">Cross country skiing</td><td>The constant for cross country skiing.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-crossTraining\">crossTraining</a></td><td style=\"color: #cccccc\">Cross training</td><td>The constant for exercise that includes any mixture of cardio, strength, and/or flexibility training.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-curling\">curling</a></td><td style=\"color: #cccccc\">Curling</td><td>The constant for curling.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-cycling\">cycling</a></td><td style=\"color: #cccccc\">Cycling</td><td>The constant for cycling.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-dance\">dance</a></td><td style=\"color: #cccccc\">Dance</td><td>(Deprecated) The constant for dancing.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-danceInspiredTraining\">danceInspiredTraining</a></td><td style=\"color: #cccccc\">Dance inspired training</td><td>(Deprecated) The constant for workouts inspired by dance, including Pilates, Barre, and Feldenkrais.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-discSports\">discSports</a></td><td style=\"color: #cccccc\">Disc sports</td><td>The constant for playing disc sports such as Ultimate and Disc Golf.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-downhillSkiing\">downhillSkiing</a></td><td style=\"color: #cccccc\">Downhill skiing</td><td>The constant for downhill skiing.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-elliptical\">elliptical</a></td><td style=\"color: #cccccc\">Elliptical</td><td>The constant for workouts on an elliptical machine.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-equestrianSports\">equestrianSports</a></td><td style=\"color: #cccccc\">Equestrian sports</td><td>The constant for activities that involve riding a horse, including polo, horse racing, and horse riding.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-fencing\">fencing</a></td><td style=\"color: #cccccc\">Fencing</td><td>The constant for fencing.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-fishing\">fishing</a></td><td style=\"color: #cccccc\">Fishing</td><td>The constant for fishing.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-fitnessGaming\">fitnessGaming</a></td><td style=\"color: #cccccc\">Fitness gaming</td><td>The constant for playing fitness-based video games.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-flexibility\">flexibility</a></td><td style=\"color: #cccccc\">Flexibility</td><td>The constant for a flexibility workout.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-functionalStrengthTraining\">functionalStrengthTraining</a></td><td style=\"color: #cccccc\">Functional strength training</td><td>The constant for strength training, primarily with free weights and body weight.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-golf\">golf</a></td><td style=\"color: #cccccc\">Golf</td><td>The constant for playing golf.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-gymnastics\">gymnastics</a></td><td style=\"color: #cccccc\">Gymnastics</td><td>Performing gymnastics.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-handball\">handball</a></td><td style=\"color: #cccccc\">Handball</td><td>The constant for playing handball.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-handCycling\">handCycling</a></td><td style=\"color: #cccccc\">Hand cycling</td><td>The constant for hand cycling.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-highIntensityIntervalTraining\">highIntensityIntervalTraining</a></td><td style=\"color: #cccccc\">High intensity interval training</td><td>The constant for high intensity interval training.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-hiking\">hiking</a></td><td style=\"color: #cccccc\">Hiking</td><td>The constant for hiking.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-hockey\">hockey</a></td><td style=\"color: #cccccc\">Hockey</td><td>The constant for playing hockey, including ice hockey, field hockey, and related sports.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-hunting\">hunting</a></td><td style=\"color: #cccccc\">Hunting</td><td>The constant for hunting.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-jumpRope\">jumpRope</a></td><td style=\"color: #cccccc\">Jump rope</td><td>The constant for jumping rope.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-kickboxing\">kickboxing</a></td><td style=\"color: #cccccc\">Kickboxing</td><td>The constant for kickboxing.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-lacrosse\">lacrosse</a></td><td style=\"color: #cccccc\">Lacrosse</td><td>The constant for playing lacrosse.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-martialArts\">martialArts</a></td><td style=\"color: #cccccc\">Martial arts</td><td>The constant for practicing martial arts.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-mindAndBody\">mindAndBody</a></td><td style=\"color: #cccccc\">Mind and body</td><td>The constant for performing activities like walking meditation, Gyrotonic exercise, and Qigong.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-mixedCardio\">mixedCardio</a></td><td style=\"color: #cccccc\">Mixed cardio</td><td>The constant for workouts that mix a variety of cardio exercise machines or modalities.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-mixedMetabolicCardioTraining\">mixedMetabolicCardioTraining</a></td><td style=\"color: #cccccc\">Mixed metabolic cardio training</td><td>The constant for performing any mix of cardio-focused exercises.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-other\">other</a></td><td style=\"color: #cccccc\">Other</td><td>The constant for a workout that does not match any of the other workout activity types.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-paddleSports\">paddleSports</a></td><td style=\"color: #cccccc\">Paddle sports</td><td>The constant for canoeing, kayaking, paddling an outrigger, paddling a stand-up paddle board, and related sports.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-pickleball\">pickleball</a></td><td style=\"color: #cccccc\">Pickleball</td><td>The constant for playing pickleball.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-pilates\">pilates</a></td><td style=\"color: #cccccc\">Pilates</td><td>The constant for a pilates workout.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-play\">play</a></td><td style=\"color: #cccccc\">Play</td><td>The constant for play-based activities like tag, dodgeball, hopscotch, tetherball, and playing on a jungle gym.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-preparationAndRecovery\">preparationAndRecovery</a></td><td style=\"color: #cccccc\">Preparation and recovery</td><td>The constant for warm-up and therapeutic activities like foam rolling and stretching.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-racquetball\">racquetball</a></td><td style=\"color: #cccccc\">Racquetball</td><td>The constant for playing racquetball.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-rowing\">rowing</a></td><td style=\"color: #cccccc\">Rowing</td><td>The constant for rowing.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-rugby\">rugby</a></td><td style=\"color: #cccccc\">Rugby</td><td>The constant for playing rugby.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-running\">running</a></td><td style=\"color: #cccccc\">Running</td><td>The constant for running and jogging.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-sailing\">sailing</a></td><td style=\"color: #cccccc\">Sailing</td><td>The constant for sailing.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-skatingSports\">skatingSports</a></td><td style=\"color: #cccccc\">Skating sports</td><td>The constant for skating activities, including ice skating, speed skating, inline skating, and skateboarding.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-snowboarding\">snowboarding</a></td><td style=\"color: #cccccc\">Snowboarding</td><td>The constant for snowboarding.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-snowSports\">snowSports</a></td><td style=\"color: #cccccc\">Snow sports</td><td>The constant for a variety of snow sports, including sledding, snowmobiling, or building a snowman.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-soccer\">soccer</a></td><td style=\"color: #cccccc\">Soccer</td><td>The constant for playing soccer.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-socialDance\">socialDance</a></td><td style=\"color: #cccccc\">Social dance</td><td>The constant for dancing with a partner or partners, such as swing, salsa, or folk dances.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-softball\">softball</a></td><td style=\"color: #cccccc\">Softball</td><td>The constant for playing softball.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-squash\">squash</a></td><td style=\"color: #cccccc\">Squash</td><td>The constant for playing squash.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-stairClimbing\">stairClimbing</a></td><td style=\"color: #cccccc\">Stair climbing</td><td>The constant for workouts using a stair climbing machine.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-stairs\">stairs</a></td><td style=\"color: #cccccc\">Stairs</td><td>The constant for running, walking, or other drills using stairs (for example, in a stadium or inside a multilevel building).</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-stepTraining\">stepTraining</a></td><td style=\"color: #cccccc\">Step training</td><td>The constant for training using a step bench.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-surfingSports\">surfingSports</a></td><td style=\"color: #cccccc\">Surfing sports</td><td>The constant for a variety of surf sports, including surfing, kite surfing, and wind surfing.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-swimBikeRun\">swimBikeRun</a></td><td style=\"color: #cccccc\">Swim bike run</td><td>The constant for multisport activities like triathlons.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-swimming\">swimming</a></td><td style=\"color: #cccccc\">Swimming</td><td>The constant for swimming.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-tableTennis\">tableTennis</a></td><td style=\"color: #cccccc\">Table tennis</td><td>The constant for playing table tennis.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-taiChi\">taiChi</a></td><td style=\"color: #cccccc\">Tai chi</td><td>The constant for tai chi.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-tennis\">tennis</a></td><td style=\"color: #cccccc\">Tennis</td><td>The constant for playing tennis.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-trackAndField\">trackAndField</a></td><td style=\"color: #cccccc\">Track and field</td><td>Participating in track and field events, including shot put, javelin, pole vaulting, and related sports.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-traditionalStrengthTraining\">traditionalStrengthTraining</a></td><td style=\"color: #cccccc\">Traditional strength training</td><td>The constant for strength training exercises primarily using machines or free weights.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-transition\">transition</a></td><td style=\"color: #cccccc\">Transition</td><td>A constant for the transition time between activities in a multisport workout.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-underwaterDiving\">underwaterDiving</a></td><td style=\"color: #cccccc\">Underwater diving</td><td>The constant for underwater diving.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-volleyball\">volleyball</a></td><td style=\"color: #cccccc\">Volleyball</td><td>The constant for playing volleyball.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-walking\">walking</a></td><td style=\"color: #cccccc\">Walking</td><td>The constant for walking.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-waterFitness\">waterFitness</a></td><td style=\"color: #cccccc\">Water fitness</td><td>The constant for aerobic exercise performed in shallow water.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-waterPolo\">waterPolo</a></td><td style=\"color: #cccccc\">Water polo</td><td>The constant for playing water polo.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-waterSports\">waterSports</a></td><td style=\"color: #cccccc\">Water sports</td><td>The constant for a variety of water sports, including water skiing, wake boarding, and related activities.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-wheelchairRunPace\">wheelchairRunPace</a></td><td style=\"color: #cccccc\">Wheelchair run pace</td><td>The constant for wheelchair workout at running pace.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-wheelchairWalkPace\">wheelchairWalkPace</a></td><td style=\"color: #cccccc\">Wheelchair walk pace</td><td>The constant for a wheelchair workout at walking pace.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-wrestling\">wrestling</a></td><td style=\"color: #cccccc\">Wrestling</td><td>The constant for wrestling.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-yoga\">yoga</a></td><td style=\"color: #cccccc\">Yoga</td><td>The constant for practicing yoga.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-backExtension\">backExtension</a></td><td style=\"color: #cccccc\">Back extension</td><td>The constant for back Extension.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-barbellShoulderPress\">barbellShoulderPress</a></td><td style=\"color: #cccccc\">Barbell shoulder press</td><td>The constant for barbell shoulder press.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-benchPress\">benchPress</a></td><td style=\"color: #cccccc\">Bench press</td><td>The constant for bench press.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-benchSitUp\">benchSitUp</a></td><td style=\"color: #cccccc\">Bench sit up</td><td>The constant for bench sit up.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-biking\">biking</a></td><td style=\"color: #cccccc\">Biking</td><td>The constant for biking.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-bikingStationary\">bikingStationary</a></td><td style=\"color: #cccccc\">Biking stationary</td><td>The constant for biking stationary.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-bootCamp\">bootCamp</a></td><td style=\"color: #cccccc\">Boot camp</td><td>The constant for boot camp.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-burpee\">burpee</a></td><td style=\"color: #cccccc\">Burpee</td><td>The constant for burpee.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-calisthenics\">calisthenics</a></td><td style=\"color: #cccccc\">Calisthenics</td><td>The constant for calisthenics.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-crunch\">crunch</a></td><td style=\"color: #cccccc\">Crunch</td><td>The constant for crunch.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-deadlift\">deadlift</a></td><td style=\"color: #cccccc\">Deadlift</td><td>The constant for deadlift.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-dumbbellCurlLeftArm\">dumbbellCurlLeftArm</a></td><td style=\"color: #cccccc\">Dumbbell curl left arm</td><td>The constant for dumbbell curl left arm.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-dumbbellCurlRightArm\">dumbbellCurlRightArm</a></td><td style=\"color: #cccccc\">Dumbbell curl right arm</td><td>The constant for dumbbell curl right arm.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-dumbbellFrontRaise\">dumbbellFrontRaise</a></td><td style=\"color: #cccccc\">Dumbbell front raise</td><td>The constant for dumbbell front raise.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-dumbbellLateralRaise\">dumbbellLateralRaise</a></td><td style=\"color: #cccccc\">Dumbbell lateral raise</td><td>The constant for dumbbell lateral raise.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-dumbbellTricepsExtensionLeftArm\">dumbbellTricepsExtensionLeftArm</a></td><td style=\"color: #cccccc\">Dumbbell triceps extension left arm</td><td>The constant for dumbbell triceps extension left arm.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-dumbbellTricepsExtensionRightArm\">dumbbellTricepsExtensionRightArm</a></td><td style=\"color: #cccccc\">Dumbbell triceps extension right arm</td><td>The constant for dumbbell triceps extension right arm.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-dumbbellTricepsExtensionTwoArm\">dumbbellTricepsExtensionTwoArm</a></td><td style=\"color: #cccccc\">Dumbbell triceps extension two arm</td><td>The constant for dumbbell triceps extension two arm.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-exerciseClass\">exerciseClass</a></td><td style=\"color: #cccccc\">Exercise class</td><td>The constant for exercise class.</td></tr><tr><td><a href=\"CodeSystem-observation-pghd-codes.html#observation-pghd-codes-forwardTwist\">forwardTwist</a></td><td style=\"color: #cccccc\">Forward twist</td><td>The constant for forward twist.</td></tr><tr><td><a href=\"CodeSystem-obser